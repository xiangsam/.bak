# Ghostty 配置（macOS 可移植版）
# 放在: ~/Library/Application Support/com.mitchellh.ghostty/config.ghostty
# (Ghostty < 1.3 请改名为 config)
#
# 字体优先级列表：找不到的条目会被自动跳过，使用下一个。
#   1) SF Mono     —— macOS 不自带；装过 Xcode 或手动安装后生效。未安装时自动降级。
#   2) Menlo       —— macOS 自带（/System/Library/Fonts/Menlo.ttc），保证任何 Mac 都能正确渲染。
#   3) PingFang SC —— macOS 自带中文；显式配置可避免自动 fallback 的 ic_width 放大，
#                     且 bold 时直接命中 PingFang SC Semibold（与系统终端一致）。
font-family = "SF Mono"
font-family = "Menlo"
font-family = "PingFang SC"
font-size = 14

shell-integration-features = ssh-terminfo,ssh-env
